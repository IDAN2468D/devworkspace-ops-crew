# Required: Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Google OAuth 2.0 (Sign-In / Registration + Google MCP)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_CREDENTIALS_PATH=./secrets/gdrive-oauth.json
GOOGLE_USER_TOKEN_PATH=./secrets/google_user_token.json

# JWT Session Auth (set AUTH_REQUIRED=true to lock API Gateway routes behind JWT / Cookie auth)
JWT_SECRET_KEY=replace_with_a_long_random_secret_string
AUTH_REQUIRED=false

# Database (SQLite locally; Docker Compose uses isolated PostgreSQL DBs: auth_db & hitl_db)
DATABASE_URL=sqlite:///./data/hitl.db

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# Apache Kafka & Elasticsearch (enabled automatically in Docker Compose; false locally for fast dev/tests)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200

# Toggle real MCP servers (false = local mock read tools for instant testing)
USE_REAL_MCP=false
MCP_GMAIL_CMD=npx -y @gongrzhe/server-gmail-autoauth-mcp
MCP_DRIVE_CMD=npx -y @modelcontextprotocol/server-gdrive
MCP_GITHUB_CMD=npx -y @modelcontextprotocol/server-github

# GitHub Credentials (required when USE_REAL_MCP=true)
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxx
GITHUB_DEFAULT_REPO=IDAN2468D/mcp-ai-ide-core
